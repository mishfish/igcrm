# --- infrastructure ---
DOMAIN=crm.example.pp.ua
POSTGRES_PASSWORD=change-me-long-random

# --- Directus (admin UI) ---
DIRECTUS_KEY=change-me-random
DIRECTUS_SECRET=change-me-long-random
DIRECTUS_ADMIN_EMAIL=you@example.com
DIRECTUS_ADMIN_PASSWORD=change-me

# --- Instagram (developers.facebook.com → your App → Instagram → API setup with Instagram login) ---
# Instagram app secret (Business login settings), NOT the App secret from Settings → Basic
IG_APP_SECRET=
# any string; enter the same one in "Configure webhooks" → Verify token
IG_VERIFY_TOKEN=change-me-random
# long-lived token (the "Generate token" button). Only needed for the first run:
# after that the service keeps it in the DB and refreshes it itself.
IG_ACCESS_TOKEN=
# 1 = overwrite the token in the DB with the value above (if you generated a new one by hand)
IG_ACCESS_TOKEN_FORCE=0
IG_API_VERSION=v23.0

# --- LLM extraction. Empty = disabled ---
# openai = any OpenAI-compatible /chat/completions (OpenAI, OpenRouter, Ollama, ...)
# claude = Claude API (console.anthropic.com) directly, no LLM_BASE_URL
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# how long to wait for silence in a thread before extracting
EXTRACT_DEBOUNCE=3m
EXTRACT_HISTORY=30

# --- Telegram alerts (optional: token expiry, backup failures, etc.) ---
TG_BOT_TOKEN=
TG_CHAT_ID=

# --- Nova Poshta (optional: TTN creation. Empty = disabled) ---
# my.novaposhta.ua → Налаштування → Безпека → Ключі API
NP_API_KEY=
# where you ship from (fixed, same for every order)
NP_SENDER_CITY=Одеса
NP_SENDER_WAREHOUSE_NO=143
