# --- інфраструктура ---
DOMAIN=crm.example.pp.ua
POSTGRES_PASSWORD=change-me-long-random

# --- Directus (адмінка) ---
DIRECTUS_KEY=change-me-random
DIRECTUS_SECRET=change-me-long-random
DIRECTUS_ADMIN_EMAIL=you@example.com
DIRECTUS_ADMIN_PASSWORD=change-me

# --- Instagram (developers.facebook.com → твій App → Instagram → API setup with Instagram login) ---
# Instagram app secret (Business login settings), НЕ App secret з Settings → Basic
IG_APP_SECRET=
# будь-який рядок; той самий вводиш у "Configure webhooks" → Verify token
IG_VERIFY_TOKEN=change-me-random
# long-lived токен (кнопка "Generate token"). Потрібен лише для першого запуску:
# далі сервіс тримає його в БД і сам оновлює.
IG_ACCESS_TOKEN=
# 1 = перезаписати токен у БД значенням вище (якщо згенерував новий вручну)
IG_ACCESS_TOKEN_FORCE=0
IG_API_VERSION=v23.0

# --- LLM-екстракція. Порожньо = вимкнено ---
# openai = будь-який OpenAI-сумісний /chat/completions (OpenAI, OpenRouter, Ollama, ...)
# claude = Claude API (console.anthropic.com) напряму, без LLM_BASE_URL
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# скільки чекати тиші в діалозі перед екстракцією
EXTRACT_DEBOUNCE=3m
EXTRACT_HISTORY=30

# --- Telegram-алерти (опційно: протухання токена тощо) ---
TG_BOT_TOKEN=
TG_CHAT_ID=
